---
import Badge from "../components/Badge.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import fotoPerfil from "../assets/ProfilePic.png";
import LinkedIn from "../icons/LinkedIn.astro";
import SocialPill from "../components/SocialPill.astro";
import GitHub from "../icons/GitHub.astro";
import MailLogo from "../icons/MailLogo.astro";
import Experience from "../components/Experience.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Maletin from "../icons/maletin.astro";
import CodeIcon from "../icons/CodeIcon.astro";
import Projects from "../components/Projects.astro";
import CurriculumIcon from "../icons/Curriculum-icon.astro";
import AboutMeIcon from "../icons/AboutMe-icon.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout id="top" title={t("meta.title")} description={t("meta.description")}>
	<main class="px-4">
		<SectionContainer class="pt-16 pb-24 lg:pt-44 lg:pb-32">
			<Image
				class="rounded-full w-32 h-32 mb-4"
				src={fotoPerfil}
				width={128}
				height={128}
				densities={[1, 2]}
				priority
				alt={t("hero.photoAlt")}
			/>
			<div
				class="flex flex-col items-start gap-3 pb-10 sm:flex-row sm:items-center"
			>
				<h1
					class="text-white text-4xl sm:text-5xl font-extrabold text-balance"
				>
					{t("hero.title")}
				</h1>
				<a
					class="inline-flex items-center py-2"
					href="https://www.linkedin.com/in/daniel-martin-hurtado/"
					target="_blank"
					rel="noopener"
				>
					<Badge>#OpenToWork</Badge>
				</a>
			</div>
			<h2
				class="text-xl lg:text-2xl text-pretty max-w-175"
				set:html={t("hero.description")}
			/>

			<nav class="flex gap-4 mt-8 flex-wrap">
				<SocialPill
					href="https://www.linkedin.com/in/daniel-martin-hurtado/"
				>
					<LinkedIn class="size-4 md:size-6" />LinkedIn
				</SocialPill>

				<SocialPill href="https://github.com/eldanimh">
					<GitHub class="size-4 md:size-6" />GitHub
				</SocialPill>

				<SocialPill
					href={`mailto:dani@danimh.dev?subject=${encodeURIComponent(t("contact.subject"))}`}
				>
					<MailLogo class="size-4 md:size-6" />dani@danimh.dev
				</SocialPill>

				<SocialPill
					href={t("hero.cvFile")}
					target="_blank"
					rel="noopener noreferrer"
				>
					<CurriculumIcon class="size-4 md:size-6" />
					{t("hero.cv")}
				</SocialPill>
			</nav>
		</SectionContainer>

		<SectionContainer id="projects" class="pb-24">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<CodeIcon class="size-7" />
				{t("nav.projects")}
			</h2>
			<Projects />
		</SectionContainer>

		<SectionContainer id="experience" class="pb-24">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<Maletin class="size-7" />
				{t("section.experience")}
			</h2>
			<Experience />
		</SectionContainer>

		<SectionContainer id="about" class="pb-24">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<AboutMeIcon class="size-7" />
				{t("section.about")}
			</h2>
			<div
				class="max-w-2xl space-y-6 text-lg leading-relaxed text-pretty"
			>
				<p>{t("about.greeting")}</p>
				<p set:html={t("about.p1")} />
				<p set:html={t("about.p2")} />
				<p>{t("about.p3")}</p>
				<p>{t("about.closing")}</p>

				<p class="mt-12">Daniel Martín Hurtado</p>
			</div>
		</SectionContainer>
	</main>
</Layout>
