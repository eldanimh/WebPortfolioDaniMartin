---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { languages } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header
    class="flex flex-wrap justify-center items-center gap-x-5 sm:gap-x-10 gap-y-2 py-5 px-4 w-full xl:w-280 mx-auto"
>
    <nav
        aria-label={t("nav.label")}
        class="flex flex-row flex-wrap justify-center w-full sm:w-auto gap-x-4 gap-y-2 sm:gap-x-10 text-sm sm:text-base"
    >
        <a
            href="#projects"
            class="opacity-80 hover:opacity-100 transition-opacity"
            >{t("nav.projects")}</a
        >
        <a
            href="#experience"
            class="opacity-80 hover:opacity-100 transition-opacity"
            >{t("nav.experience")}</a
        >
        <a href="#about" class="opacity-80 hover:opacity-100 transition-opacity"
            >{t("nav.about")}</a
        >
        <a
            href={`mailto:dani@danimh.dev?subject=${encodeURIComponent(t("contact.subject"))}`}
            class="opacity-80 hover:opacity-100 transition-opacity"
            >{t("nav.contact")}</a
        >
    </nav>
    <div
        aria-label={t("lang.label")}
        class="flex gap-2 text-sm sm:border-l sm:border-white/20 sm:pl-5"
    >
        {
            Object.keys(languages).map((code) => (
                <a
                    href={getRelativeLocaleUrl(code)}
                    hreflang={code}
                    aria-current={code === lang ? "page" : undefined}
                    class={
                        code === lang
                            ? "font-bold"
                            : "opacity-60 hover:opacity-100"
                    }
                >
                    {code.toUpperCase()}
                </a>
            ))
        }
    </div>
</header>
