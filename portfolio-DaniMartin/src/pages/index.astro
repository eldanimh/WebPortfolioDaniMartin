---
import Badge from '../components/Badge.astro';
import Layout from '../layouts/Layout.astro';
import { Image } from "astro:assets";
import fotoPerfil from "../assets/ProfilePic.png";
---

<Layout>
	<main>
		<section class="w-full mx-auto lg:w-185 py-44">
			<Image class="rounded-full w-32 h-32 mb-4" src={fotoPerfil} alt="Foto de Daniel Martín Hurtado"/>
			<div class="flex items-center gap-3 pb-10">
				
				<h1 class="text-white text-5xl font-bold">
					¡Hola!, soy Daniel Martín
				</h1>
				<a href="https://www.linkedin.com/in/daniel-martin-hurtado/" target="_blank" rel="noopener">
					<Badge>#OpenToWork</Badge>
				</a>
			</div>
			<h2 class="text-2xl opacity-80 text-wrap">
				Estudiante de <span class="font-bold">Ingeniería de Telecomuniaciones</span> con un
				gran interés en el ámbito tecnológico. Apasionado por la Programación,
				especialmente por <span class="font-bold">Python</span>, y por la <span class="font-bold"> Arquitectura de Internet</span>.
			</h2>

			<ul></ul>
		</section>
	</main>
</Layout>
