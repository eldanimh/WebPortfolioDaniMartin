---
import Badge from '../components/Badge.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<section class="w-full mx-auto lg:w-185 py-44">
			<div class="flex items-center gap-3">
				<h1 class="text-white text-5xl font-bold">
					¡Hola!, soy Dani Martín
				</h1>
				<Badge>#OpenToWork</Badge>
			</div>
			<h2 class="text-xl">
				Estudiante de Ingeniería de Telecomuniaciones con un
				gran interés en el ámbito tecnológico. Apasionado por la programación,
				especialmente por Python, y por la arquitectura de internet.
			</h2>

			<ul></ul>
		</section>
	</main>
</Layout>
